<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:IvanConnections_Travel.ViewModels"
             x:Class="IvanConnections_Travel.Views.OnboardingPage"
             x:DataType="vm:OnboardingViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}"
             Title="Bun venit">

    <Grid RowDefinitions="Auto, *, Auto, Auto"
          Padding="24,16,24,32"
          RowSpacing="16">

        <!-- Skip -->
        <Button Grid.Row="0"
                Text="Sari peste"
                Command="{Binding SkipCommand}"
                HorizontalOptions="End"
                MinimumHeightRequest="44"
                MinimumWidthRequest="44"
                BackgroundColor="Transparent"
                FontAttributes="Bold"
                TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                SemanticProperties.Description="Sari peste turul de introducere" />

        <!-- Slides -->
        <CarouselView Grid.Row="1"
                      x:Name="Carousel"
                      ItemsSource="{Binding Slides}"
                      Position="{Binding Position, Mode=TwoWay}"
                      IndicatorView="{x:Reference Indicators}"
                      Loop="False"
                      HorizontalScrollBarVisibility="Never">
            <CarouselView.ItemTemplate>
                <DataTemplate x:DataType="vm:OnboardingSlide">
                    <VerticalStackLayout Spacing="20"
                                         Padding="8,0"
                                         VerticalOptions="Center">
                        <Border WidthRequest="160"
                                HeightRequest="160"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 80"
                                HorizontalOptions="Center"
                                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMutedLight}, Dark={StaticResource SurfaceMutedDark}}">
                            <Label Text="{Binding Emoji}"
                                   FontSize="72"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   SemanticProperties.Description="{Binding Title}" />
                        </Border>
                        <Label Text="{Binding Title}"
                               FontSize="26"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               SemanticProperties.HeadingLevel="Level1"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                        <Label Text="{Binding Description}"
                               FontSize="16"
                               LineHeight="1.3"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CarouselView.ItemTemplate>
        </CarouselView>

        <IndicatorView Grid.Row="2"
                       x:Name="Indicators"
                       HorizontalOptions="Center"
                       IndicatorSize="10"
                       IndicatorColor="{AppThemeBinding Light={StaticResource DividerLight}, Dark={StaticResource DividerDark}}"
                       SelectedIndicatorColor="{StaticResource Accent}" />

        <Button Grid.Row="3"
                Style="{StaticResource AccentButton}"
                Text="{Binding NextButtonText}"
                Command="{Binding NextCommand}"
                HeightRequest="52" />
    </Grid>
</ContentPage>
