<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:IvanConnections_Travel.ViewModels"
             xmlns:converters="clr-namespace:IvanConnections_Travel.Converters"
             x:Class="IvanConnections_Travel.Views.SchedulePage"
             x:DataType="vm:ScheduleViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}"
             Title="Orar Metropolitan">

    <ContentPage.Resources>
        <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        <converters:NullToBoolConverter x:Key="NullToBoolConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*">

        <ActivityIndicator Grid.RowSpan="3"
                           IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           Color="{StaticResource Accent}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           ZIndex="10" />

        <!-- Header -->
        <HorizontalStackLayout Grid.Row="0"
                               Spacing="8"
                               Padding="8,12,16,8"
                               VerticalOptions="Center">
            <Button Clicked="OnMenuClicked"
                    HeightRequest="48"
                    WidthRequest="48"
                    Padding="0"
                    BackgroundColor="Transparent"
                    SemanticProperties.Description="Deschide meniul"
                    VerticalOptions="Center">
                <Button.ImageSource>
                    <FontImageSource FontFamily="MaterialSymbolsRounded"
                                     Glyph="&#xe5d2;"
                                     Size="30"
                                     Color="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                </Button.ImageSource>
            </Button>
            <Label Text="Orar"
                   FontSize="26"
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   SemanticProperties.HeadingLevel="Level1"
                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
        </HorizontalStackLayout>

        <!-- Controls: route selector, stop tabs, day type, next departure -->
        <VerticalStackLayout Grid.Row="1" Spacing="12" Padding="16,0,16,12">

            <!-- Selected route bar -->
            <Border Style="{StaticResource CardBorder}"
                    Padding="8"
                    IsVisible="{Binding SelectedRoute, Converter={StaticResource NullToBoolConverter}, ConverterParameter=invert}">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                    <Border Grid.Column="0"
                            WidthRequest="52"
                            HeightRequest="48"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="{Binding SelectedRouteChip.ChipColor, TargetNullValue={StaticResource Accent}}">
                        <Label Text="{Binding SelectedRouteChip.ShortName}"
                               FontSize="17"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               TextColor="{Binding SelectedRouteChip.ChipTextColor, TargetNullValue={StaticResource OnAccent}}" />
                    </Border>

                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleRouteSelectorCommand}" />
                        </VerticalStackLayout.GestureRecognizers>
                        <Label Text="{Binding SelectedRouteChip.LongName}"
                               Style="{StaticResource TitleLabel}"
                               FontSize="14"
                               LineBreakMode="TailTruncation"
                               MaxLines="2" />
                        <Label Text="Atinge pentru a schimba ruta"
                               Style="{StaticResource SubtitleLabel}"
                               FontSize="12" />
                    </VerticalStackLayout>

                    <!-- Favorite toggle (icon-only) -->
                    <Button Grid.Column="2"
                            Command="{Binding ToggleFavoriteCommand}"
                            Text="&#xe838;"
                            FontFamily="MaterialSymbolsRounded"
                            FontSize="26"
                            WidthRequest="48"
                            HeightRequest="48"
                            Padding="0"
                            CornerRadius="24"
                            BackgroundColor="Transparent"
                            VerticalOptions="Center"
                            SemanticProperties.Description="Adaugă ruta la favorite"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsFavorite}" Value="True">
                                <Setter Property="TextColor" Value="{StaticResource Warning}" />
                                <Setter Property="SemanticProperties.Description" Value="Elimină ruta din favorite" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>

                    <!-- Expand / collapse route selector (icon-only) -->
                    <Button Grid.Column="3"
                            Command="{Binding ToggleRouteSelectorCommand}"
                            Text="&#xe5cf;"
                            FontFamily="MaterialSymbolsRounded"
                            FontSize="28"
                            WidthRequest="48"
                            HeightRequest="48"
                            Padding="0"
                            CornerRadius="24"
                            BackgroundColor="Transparent"
                            VerticalOptions="Center"
                            SemanticProperties.Description="Schimbă ruta"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsRouteSelectorOpen}" Value="True">
                                <Setter Property="Text" Value="&#xe5ce;" />
                                <Setter Property="SemanticProperties.Description" Value="Închide lista de rute" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>
            </Border>

            <!-- Searchable route selector -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsRouteSelectorOpen}">
                <Border Style="{StaticResource CardBorder}" Padding="12,0">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Label Grid.Column="0"
                               Text="&#xe8b6;"
                               FontFamily="MaterialSymbolsRounded"
                               FontSize="22"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                        <Entry Grid.Column="1"
                               Text="{Binding RouteFilter}"
                               Placeholder="Caută ruta (număr sau nume)"
                               ClearButtonVisibility="WhileEditing"
                               ReturnType="Search"
                               MinimumHeightRequest="48"
                               BackgroundColor="Transparent"
                               SemanticProperties.Description="Caută ruta"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                               PlaceholderColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                    </Grid>
                </Border>

                <Label Text="Nicio rută nu corespunde căutării."
                       Style="{StaticResource SubtitleLabel}"
                       HorizontalOptions="Center"
                       Margin="0,8"
                       IsVisible="{Binding HasNoMatchingRoutes}" />

                <CollectionView ItemsSource="{Binding RouteChips}"
                                SelectionMode="None"
                                HeightRequest="232"
                                IsVisible="{Binding HasNoMatchingRoutes, Converter={StaticResource InvertedBoolConverter}}">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical"
                                         Span="5"
                                         HorizontalItemSpacing="8"
                                         VerticalItemSpacing="8" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:RouteChipItem">
                            <Border HeightRequest="48"
                                    StrokeThickness="3"
                                    Stroke="Transparent"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="2"
                                    SemanticProperties.Description="{Binding ShortName, StringFormat='Ruta {0}'}"
                                    SemanticProperties.Hint="{Binding LongName}"
                                    BackgroundColor="{Binding ChipColor, TargetNullValue={StaticResource Accent}}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ScheduleViewModel}}, Path=SelectRouteCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid>
                                    <Label Text="{Binding ShortName}"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           LineBreakMode="TailTruncation"
                                           TextColor="{Binding ChipTextColor, TargetNullValue={StaticResource OnAccent}}" />
                                    <Label Text="&#xe838;"
                                           FontFamily="MaterialSymbolsRounded"
                                           FontSize="12"
                                           HorizontalOptions="End"
                                           VerticalOptions="Start"
                                           IsVisible="{Binding IsFavorite}"
                                           TextColor="{Binding ChipTextColor, TargetNullValue={StaticResource OnAccent}}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <!-- Content shown after a route is selected -->
            <VerticalStackLayout Spacing="12"
                                 IsVisible="{Binding SelectedRoute, Converter={StaticResource NullToBoolConverter}, ConverterParameter=invert}">

                <!-- Starting stop tabs -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Plecare din"
                           Style="{StaticResource SectionHeaderLabel}"
                           Margin="2,0,0,0" />
                    <FlexLayout BindableLayout.ItemsSource="{Binding StopTabs}"
                                Wrap="Wrap"
                                Direction="Row"
                                JustifyContent="Start"
                                AlignItems="Center">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:StopTabItem">
                                <Border Padding="16,0"
                                        Margin="0,0,8,8"
                                        MinimumHeightRequest="44"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 22"
                                        SemanticProperties.Description="{Binding StartingStop, StringFormat='Plecare din {0}'}"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMutedLight}, Dark={StaticResource SurfaceMutedDark}}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ScheduleViewModel}}, Path=SelectStartingStopCommand}"
                                            CommandParameter="{Binding StartingStop}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="{Binding StartingStop}"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="TextColor" Value="{StaticResource OnAccent}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </VerticalStackLayout>

                <!-- Day type selector -->
                <Border StrokeThickness="0"
                        StrokeShape="RoundRectangle 24"
                        Padding="4"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMutedLight}, Dark={StaticResource SurfaceMutedDark}}">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="4">

                        <!-- Weekday -->
                        <Border Grid.Column="0"
                                Padding="12,0"
                                MinimumHeightRequest="44"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 20"
                                SemanticProperties.Description="Orar Luni-Vineri"
                                BackgroundColor="Transparent">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding SelectedDayType}" Value="weekday">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectDayTypeCommand}" CommandParameter="weekday" />
                            </Border.GestureRecognizers>
                            <Label Text="Luni-Vineri"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding SelectedDayType}" Value="weekday">
                                        <Setter Property="TextColor" Value="{StaticResource OnAccent}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>

                        <!-- Weekend & holidays -->
                        <Border Grid.Column="1"
                                Padding="12,0"
                                MinimumHeightRequest="44"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 20"
                                SemanticProperties.Description="Orar Weekend și Sărbători"
                                BackgroundColor="Transparent">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding SelectedDayType}" Value="weekend">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectDayTypeCommand}" CommandParameter="weekend" />
                            </Border.GestureRecognizers>
                            <Label Text="Weekend și Sărbători"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding SelectedDayType}" Value="weekend">
                                        <Setter Property="TextColor" Value="{StaticResource OnAccent}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>

                    </Grid>
                </Border>

                <!-- Loading schedules indicator -->
                <ActivityIndicator IsRunning="{Binding IsLoadingSchedules}"
                                   IsVisible="{Binding IsLoadingSchedules}"
                                   Color="{StaticResource Accent}"
                                   HorizontalOptions="Center" />

                <!-- Next departure header -->
                <Border Style="{StaticResource BannerBorder}"
                        Margin="0"
                        Padding="12,10"
                        IsVisible="{Binding ShowNextDepartureInfo}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMutedLight}, Dark={StaticResource SurfaceMutedDark}}">
                    <HorizontalStackLayout Spacing="8">
                        <Label Text="&#xe8b5;"
                               FontFamily="MaterialSymbolsRounded"
                               FontSize="22"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding HasNextDeparture}" Value="True">
                                    <Setter Property="TextColor" Value="{StaticResource Accent}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Label Text="{Binding NextDepartureText}"
                               Style="{StaticResource TitleLabel}"
                               FontSize="15"
                               VerticalOptions="Center"
                               SemanticProperties.Description="{Binding NextDepartureText}" />
                    </HorizontalStackLayout>
                </Border>

                <!-- School-period extra buses note (Luni-Vineri only) -->
                <Border Style="{StaticResource BannerBorder}"
                        Margin="0"
                        Padding="12,10"
                        IsVisible="{Binding HasSchoolSchedules}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMutedLight}, Dark={StaticResource SurfaceMutedDark}}">
                    <HorizontalStackLayout Spacing="8">
                        <Label Text="&#xe80c;"
                               FontFamily="MaterialSymbolsRounded"
                               FontSize="20"
                               VerticalOptions="Center"
                               TextColor="{StaticResource Warning}" />
                        <Label Text="Autobuze suplimentate pe perioada școlii."
                               FontSize="13"
                               FontAttributes="Bold"
                               VerticalOptions="Center"
                               LineBreakMode="WordWrap"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                    </HorizontalStackLayout>
                </Border>
            </VerticalStackLayout>
        </VerticalStackLayout>

        <!-- Empty state: no route selected -->
        <VerticalStackLayout Grid.Row="2"
                             Spacing="12"
                             HorizontalOptions="Center"
                             Margin="16,24,16,0"
                             IsVisible="{Binding SelectedRoute, Converter={StaticResource NullToBoolConverter}}">
            <Label Text="&#xe530;"
                   FontFamily="MaterialSymbolsRounded"
                   FontSize="48"
                   TextColor="{AppThemeBinding Light={StaticResource DividerLight}, Dark={StaticResource DividerDark}}"
                   HorizontalOptions="Center" />
            <Label Text="Selectează o rută pentru a vedea orarul."
                   Style="{StaticResource SubtitleLabel}"
                   FontSize="14"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <!-- No results message -->
        <VerticalStackLayout Grid.Row="2"
                             IsVisible="{Binding HasNoResults}"
                             Spacing="8"
                             HorizontalOptions="Center"
                             Margin="16,16,16,0">
            <Label Text="&#xe8f4;"
                   FontFamily="MaterialSymbolsRounded"
                   FontSize="48"
                   TextColor="{AppThemeBinding Light={StaticResource DividerLight}, Dark={StaticResource DividerDark}}"
                   HorizontalOptions="Center" />
            <Label Text="Nu există curse pentru această zi."
                   Style="{StaticResource SubtitleLabel}"
                   FontSize="14"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Schedule time grid -->
        <CollectionView x:Name="TripsCollection"
                        Grid.Row="2"
                        ItemsSource="{Binding Schedules}"
                        SelectionMode="None"
                        Margin="16,0"
                        IsVisible="{Binding HasSchedules}">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical"
                                 Span="4"
                                 HorizontalItemSpacing="8"
                                 VerticalItemSpacing="8" />
            </CollectionView.ItemsLayout>
            <CollectionView.Footer>
                <BoxView HeightRequest="24" Color="Transparent" />
            </CollectionView.Footer>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:TripItem">
                    <Border HeightRequest="48"
                            StrokeThickness="2"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 10"
                            SemanticProperties.Description="{Binding DepartureDisplay, StringFormat='Plecare la {0}'}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMutedLight}, Dark={StaticResource SurfaceMutedDark}}">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsPast}" Value="True">
                                <Setter Property="Opacity" Value="0.4" />
                            </DataTrigger>
                            <DataTrigger TargetType="Border" Binding="{Binding IsNext}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
                                <Setter Property="Stroke" Value="{StaticResource AccentDark}" />
                                <Setter Property="SemanticProperties.Hint" Value="Următoarea plecare" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Label Text="{Binding DepartureDisplay}"
                               FontSize="15"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsNext}" Value="True">
                                    <Setter Property="TextColor" Value="{StaticResource OnAccent}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
