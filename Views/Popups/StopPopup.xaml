<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:vm="clr-namespace:IvanConnections_Travel.ViewModels.Popups"
               xmlns:model="clr-namespace:IvanConnections_Travel.Models"
               CanBeDismissedByTappingOutsideOfPopup="True"
               x:DataType="vm:StopPopupViewModel"
               BackgroundColor="Transparent"
               x:Class="IvanConnections_Travel.Views.Popups.StopPopup">
    <Border x:Name="RootCard"
            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource OffBlackBorder}}"
            StrokeThickness="1"
            BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}"
            MinimumWidthRequest="300"
            MaximumWidthRequest="400"
            VerticalOptions="Start"
            Padding="0">
        <Border.Shadow>
            <Shadow Brush="Black"
                    Offset="0,8"
                    Radius="24"
                    Opacity="0.25" />
        </Border.Shadow>
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="24" />
        </Border.StrokeShape>
        <!-- Antet fix, lista de sosiri care se poate derula, acțiuni mereu vizibile.
             Toate rândurile sunt Auto, astfel încât cardul să se strângă exact pe conținut;
             înălțimea maximă a listei este calculată în code-behind. -->
        <Grid RowDefinitions="Auto, Auto, Auto"
              VerticalOptions="Start">
            <!-- Header: identitatea stației -->
            <Border x:Name="HeaderBorder"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 23,23,0,0"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                    Padding="16,14">
                <Grid ColumnDefinitions="Auto, *, Auto"
                      ColumnSpacing="12">
                    <!-- Pictogramă stație -->
                    <Border Grid.Column="0"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 16"
                            BackgroundColor="#38FFFFFF"
                            MinimumWidthRequest="48"
                            MinimumHeightRequest="48"
                            Padding="8,6"
                            VerticalOptions="Center">
                        <Label FontFamily="MaterialSymbolsRounded"
                               Text="&#xe576;"
                               FontSize="26"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               TextColor="White" />
                    </Border>

                    <!-- Nume stație -->
                    <VerticalStackLayout Grid.Column="1"
                                         Spacing="2"
                                         VerticalOptions="Center">
                        <Label Text="Stație"
                               FontSize="11"
                               CharacterSpacing="1.5"
                               TextColor="#C8FFFFFF" />
                        <Label Text="{Binding Stop.StopName}"
                               FontSize="17"
                               FontAttributes="Bold"
                               MaxLines="2"
                               LineBreakMode="TailTruncation"
                               TextColor="White" />
                    </VerticalStackLayout>

                    <!-- Close (X) -->
                    <Button Grid.Column="2"
                            Clicked="CloseButton_Clicked"
                            ToolTipProperties.Text="Închide"
                            SemanticProperties.Description="Închide detaliile stației"
                            CornerRadius="18"
                            HeightRequest="36"
                            WidthRequest="36"
                            Padding="0"
                            VerticalOptions="Start"
                            BackgroundColor="#38FFFFFF">
                        <Button.ImageSource>
                            <FontImageSource FontFamily="MaterialSymbolsRounded"
                                             Glyph="&#xe5cd;"
                                             Size="20"
                                             Color="White" />
                        </Button.ImageSource>
                    </Button>
                </Grid>
            </Border>

            <!-- Corpul popup-ului: sosirile din stație -->
            <ScrollView Grid.Row="1"
                        x:Name="DetailsScroll"
                        MinimumHeightRequest="0"
                        VerticalOptions="Start"
                        VerticalScrollBarVisibility="Default">
                <VerticalStackLayout Spacing="12"
                                     Padding="16,14,16,14">
                    <!-- Detalii secundare ale stației (cod / descriere) -->
                    <Grid ColumnDefinitions="Auto, *"
                          ColumnSpacing="6"
                          IsVisible="{Binding StopSubtitle, Converter={toolkit:IsStringNotNullOrEmptyConverter}}">
                        <Label FontFamily="MaterialSymbolsRounded"
                               Text="&#xe55f;"
                               FontSize="16"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                        <Label Grid.Column="1"
                               Text="{Binding StopSubtitle}"
                               FontSize="12"
                               MaxLines="2"
                               LineBreakMode="TailTruncation"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                    </Grid>

                    <!-- Titlul secțiunii + reîmprospătare -->
                    <Grid ColumnDefinitions="*, Auto"
                          ColumnSpacing="8">
                        <VerticalStackLayout Spacing="1"
                                             VerticalOptions="Center">
                            <Label Text="Sosiri"
                                   FontSize="15"
                                   FontAttributes="Bold" />
                            <Label Text="{Binding ArrivalsSummary}"
                                   IsVisible="{Binding ArrivalsSummary, Converter={toolkit:IsStringNotNullOrEmptyConverter}}"
                                   FontSize="11"
                                   MaxLines="2"
                                   LineBreakMode="TailTruncation"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                        </VerticalStackLayout>

                        <Button Grid.Column="1"
                                Command="{Binding RefreshCommand}"
                                IsEnabled="{Binding IsLoading, Converter={toolkit:InvertedBoolConverter}}"
                                ToolTipProperties.Text="Reîmprospătează"
                                SemanticProperties.Description="Reîmprospătează sosirile"
                                CornerRadius="18"
                                HeightRequest="36"
                                WidthRequest="36"
                                Padding="0"
                                VerticalOptions="Center"
                                BackgroundColor="Transparent"
                                BorderColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource OffBlackBorder}}"
                                BorderWidth="1">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="MaterialSymbolsRounded"
                                                 Glyph="&#xe5d5;"
                                                 Size="20"
                                                 Color="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                            </Button.ImageSource>
                        </Button>
                    </Grid>

                    <!-- Se încarcă -->
                    <Border IsVisible="{Binding IsLoading}"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource OffBlackBorder}}"
                            StrokeShape="RoundRectangle 16"
                            BackgroundColor="{AppThemeBinding Light=#F7F8FA, Dark=#1a2233}"
                            Padding="14,16">
                        <HorizontalStackLayout Spacing="10"
                                               HorizontalOptions="Center">
                            <ActivityIndicator IsRunning="{Binding IsLoading}"
                                               HeightRequest="20"
                                               WidthRequest="20"
                                               VerticalOptions="Center"
                                               Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                            <Label Text="Se încarcă sosirile…"
                                   FontSize="13"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Lista sosirilor (BindableLayout, ca să nu se creeze o zonă
                         derulabilă în interiorul celei principale) -->
                    <VerticalStackLayout IsVisible="{Binding HasArrivals}"
                                         Spacing="8"
                                         BindableLayout.ItemsSource="{Binding Arrivals}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="model:StopArrival">
                                <Border StrokeThickness="1"
                                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource OffBlackBorder}}"
                                        StrokeShape="RoundRectangle 16"
                                        BackgroundColor="{AppThemeBinding Light=#F7F8FA, Dark=#1a2233}"
                                        Padding="12,10">
                                    <Grid ColumnDefinitions="Auto, *, Auto"
                                          ColumnSpacing="12">
                                        <!-- Pastila traseului, colorată după tipul vehiculului -->
                                        <Border Grid.Column="0"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 12"
                                                BackgroundColor="{Binding AccentColor}"
                                                MinimumWidthRequest="54"
                                                Padding="8,6"
                                                VerticalOptions="Center">
                                            <Grid ColumnDefinitions="Auto, Auto"
                                                  ColumnSpacing="5"
                                                  HorizontalOptions="Center"
                                                  VerticalOptions="Center">
                                                <Label FontFamily="MaterialSymbolsRounded"
                                                       Text="{Binding VehicleGlyph}"
                                                       FontSize="18"
                                                       VerticalOptions="Center"
                                                       TextColor="White" />
                                                <Label Grid.Column="1"
                                                       Text="{Binding VehicleLabel}"
                                                       FontSize="16"
                                                       FontAttributes="Bold"
                                                       LineBreakMode="TailTruncation"
                                                       VerticalOptions="Center"
                                                       TextColor="White" />
                                            </Grid>
                                        </Border>

                                        <!-- Tipul vehiculului + explicație -->
                                        <VerticalStackLayout Grid.Column="1"
                                                             Spacing="1"
                                                             VerticalOptions="Center">
                                            <Label Text="{Binding TypeName}"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding ArrivalHint}"
                                                   FontSize="11"
                                                   LineBreakMode="TailTruncation"
                                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                                        </VerticalStackLayout>

                                        <!-- Timpul până la sosire -->
                                        <VerticalStackLayout Grid.Column="2"
                                                             Spacing="0"
                                                             VerticalOptions="Center"
                                                             HorizontalOptions="End">
                                            <Label Text="{Binding ArrivalValue}"
                                                   FontSize="20"
                                                   FontAttributes="Bold"
                                                   HorizontalOptions="End"
                                                   LineBreakMode="TailTruncation"
                                                   TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label"
                                                                 Binding="{Binding IsImminent}"
                                                                 Value="True">
                                                        <Setter Property="TextColor" Value="#16A34A" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label"
                                                                 Binding="{Binding IsAtTerminus}"
                                                                 Value="True">
                                                        <Setter Property="FontSize" Value="13" />
                                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                            <Label Text="min"
                                                   IsVisible="{Binding HasArrivalUnit}"
                                                   FontSize="11"
                                                   HorizontalOptions="End"
                                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <!-- Nicio sosire / eroare -->
                    <Border IsVisible="{Binding ErrorMessage, Converter={toolkit:IsStringNotNullOrEmptyConverter}}"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource OffBlackBorder}}"
                            StrokeShape="RoundRectangle 16"
                            BackgroundColor="{AppThemeBinding Light=#F7F8FA, Dark=#1a2233}"
                            Padding="14,16">
                        <VerticalStackLayout Spacing="6">
                            <Label FontFamily="MaterialSymbolsRounded"
                                   Text="&#xe8b5;"
                                   FontSize="28"
                                   HorizontalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray500}}" />
                            <Label Text="{Binding ErrorMessage}"
                                   FontSize="13"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="WordWrap"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                        </VerticalStackLayout>
                    </Border>

                    <Label Text="{Binding LastUpdateText}"
                           IsVisible="{Binding LastUpdateText, Converter={toolkit:IsStringNotNullOrEmptyConverter}}"
                           FontSize="11"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" />
                </VerticalStackLayout>
            </ScrollView>

            <!-- Acțiuni -->
            <VerticalStackLayout x:Name="ActionsPanel"
                                 Grid.Row="2"
                                 Spacing="8"
                                 Padding="16,0,16,16">
                <Button Text="Schimbă sensul"
                        Command="{Binding SwitchDirectionCommand}"
                        IsVisible="{Binding CanSwitchDirection}"
                        CornerRadius="22"
                        MinimumHeightRequest="44"
                        FontSize="14"
                        FontAttributes="Bold"
                        LineBreakMode="WordWrap"
                        Padding="8,6"
                        BackgroundColor="Transparent"
                        BorderColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource OffBlackBorder}}"
                        BorderWidth="1"
                        TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="MaterialSymbolsRounded"
                                         Glyph="&#xe8d5;"
                                         Size="18"
                                         Color="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                    </Button.ImageSource>
                </Button>

                <Button Text="Adaugă widget"
                        Command="{Binding PinWidgetCommand}"
                        IsVisible="{Binding CanPinWidget}"
                        CornerRadius="22"
                        MinimumHeightRequest="44"
                        FontSize="14"
                        FontAttributes="Bold"
                        LineBreakMode="WordWrap"
                        Padding="8,6"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                        TextColor="White">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="MaterialSymbolsRounded"
                                         Glyph="&#xe1bd;"
                                         Size="18"
                                         Color="White" />
                    </Button.ImageSource>
                </Button>
            </VerticalStackLayout>
        </Grid>
    </Border>
</toolkit:Popup>
