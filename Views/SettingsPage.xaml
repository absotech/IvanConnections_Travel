<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:IvanConnections_Travel.ViewModels"
             xmlns:controls="clr-namespace:IvanConnections_Travel.Controls"
             x:DataType="vm:SettingsViewModel"
             x:Class="IvanConnections_Travel.Views.SettingsPage"
             xmlns:xct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}"
             x:Name="This"
             Title="Setări">
    <ContentPage.Behaviors>
        <xct:EventToCommandBehavior EventName="Appearing"
                                    BindingContext="{Binding Path=BindingContext, Source={x:Reference This}}"
                                    Command="{Binding AppearingCommand}" />
    </ContentPage.Behaviors>

    <ContentPage.Resources>
        <Style x:Key="TrailingPicker" TargetType="Picker">
            <Setter Property="WidthRequest" Value="130" />
            <Setter Property="MinimumHeightRequest" Value="44" />
            <Setter Property="HorizontalTextAlignment" Value="End" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextColor" Value="{StaticResource Accent}" />
        </Style>

        <!-- Map-like preview background (roads on a muted surface) -->
        <ControlTemplate x:Key="MapPreviewTemplate">
            <Border StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    HeightRequest="96"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMutedLight}, Dark={StaticResource SurfaceMutedDark}}">
                <Grid>
                    <BoxView HeightRequest="10"
                             VerticalOptions="Center"
                             Color="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource DividerDark}}" />
                    <BoxView WidthRequest="8"
                             HorizontalOptions="Start"
                             Margin="36,0,0,0"
                             Color="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource DividerDark}}" />
                    <BoxView WidthRequest="6"
                             HorizontalOptions="End"
                             Margin="0,0,48,0"
                             Rotation="20"
                             Color="{AppThemeBinding Light={StaticResource DividerLight}, Dark={StaticResource DividerDark}}" />
                    <ContentPresenter HorizontalOptions="Center" VerticalOptions="Center" />
                </Grid>
            </Border>
        </ControlTemplate>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20,24,20,32" Spacing="10">
            <!-- Header -->
            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                <Button Clicked="OnMenuClicked"
                        HeightRequest="44"
                        WidthRequest="44"
                        Padding="0"
                        BackgroundColor="Transparent"
                        SemanticProperties.Description="Deschide meniul"
                        VerticalOptions="Center">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="MaterialSymbolsRounded"
                                         Glyph="&#xe5d2;"
                                         Size="30"
                                         Color="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                    </Button.ImageSource>
                </Button>
                <Label Text="Setări"
                       FontSize="26"
                       FontAttributes="Bold"
                       VerticalOptions="Center"
                       SemanticProperties.HeadingLevel="Level1"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
            </HorizontalStackLayout>

            <!-- ===== Hartă ===== -->
            <Label Text="Hartă" Style="{StaticResource SectionHeaderLabel}" SemanticProperties.HeadingLevel="Level2" />

            <controls:SettingsRow Icon="🚦"
                                  Title="Trafic"
                                  Subtitle="Afișează traficul în timp real pe hartă">
                <Switch IsToggled="{Binding IsTrafficEnabled}"
                        OnColor="{StaticResource Accent}"
                        SemanticProperties.Description="Trafic" />
            </controls:SettingsRow>

            <controls:SettingsRow Icon="🚏"
                                  Title="Stații"
                                  Subtitle="Afișează stațiile pe hartă">
                <Switch IsToggled="{Binding ShowStopsOnMap}"
                        OnColor="{StaticResource Accent}"
                        SemanticProperties.Description="Stații" />
            </controls:SettingsRow>

            <Border Style="{StaticResource CardBorder}" Padding="16,12">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Dimensiune stații" Style="{StaticResource TitleLabel}" VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="{Binding StopSize}"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Accent}"
                               VerticalOptions="Center" />
                    </Grid>
                    <Slider Minimum="15"
                            Maximum="30"
                            MinimumTrackColor="{StaticResource Accent}"
                            ThumbColor="{StaticResource Accent}"
                            SemanticProperties.Description="Dimensiune stații"
                            Value="{Binding StopSizeSlider}" />
                    <ContentView ControlTemplate="{StaticResource MapPreviewTemplate}">
                        <Image Source="{Binding StopPreview}"
                               HeightRequest="{Binding StopSize}"
                               WidthRequest="{Binding StopSize}"
                               Aspect="Center"
                               SemanticProperties.Description="Previzualizare stație" />
                    </ContentView>
                </VerticalStackLayout>
            </Border>

            <controls:SettingsRow Icon="⏱️"
                                  Title="Interval de actualizare"
                                  Subtitle="Cât de des se actualizează pozițiile vehiculelor">
                <Picker Style="{StaticResource TrailingPicker}"
                        Title="Interval"
                        ItemsSource="{Binding RefreshIntervalOptions}"
                        SelectedIndex="{Binding RefreshIntervalIndex}"
                        SemanticProperties.Description="Interval de actualizare" />
            </controls:SettingsRow>

            <!-- ===== Vehicule ===== -->
            <Label Text="Vehicule" Style="{StaticResource SectionHeaderLabel}" SemanticProperties.HeadingLevel="Level2" />

            <controls:SettingsRow Icon="🔢"
                                  Title="Doar numărul rutei"
                                  Subtitle="Afișează doar numărul rutei pe fundal colorat, fără pictograma vehiculului">
                <Switch IsToggled="{Binding ShowNumberOnly}"
                        OnColor="{StaticResource Accent}"
                        SemanticProperties.Description="Doar numărul rutei" />
            </controls:SettingsRow>

            <controls:SettingsRow Icon="ℹ️"
                                  Title="Arată mai multe informații"
                                  Subtitle="Afișează codul vehiculului și accesibilitatea în fereastra vehiculului">
                <Switch IsToggled="{Binding ShowMoreVehicleInfo}"
                        OnColor="{StaticResource Accent}"
                        SemanticProperties.Description="Arată mai multe informații" />
            </controls:SettingsRow>

            <Border Style="{StaticResource CardBorder}" Padding="16,12">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Dimensiune vehicule" Style="{StaticResource TitleLabel}" VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="{Binding VehicleSize}"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Accent}"
                               VerticalOptions="Center" />
                    </Grid>
                    <Slider Minimum="25"
                            Maximum="35"
                            MinimumTrackColor="{StaticResource Accent}"
                            ThumbColor="{StaticResource Accent}"
                            SemanticProperties.Description="Dimensiune vehicule"
                            Value="{Binding VehicleSizeSlider}" />
                    <ContentView ControlTemplate="{StaticResource MapPreviewTemplate}">
                        <Image Source="{Binding VehiclePreview}"
                               HeightRequest="{Binding VehicleDisplaySize}"
                               WidthRequest="{Binding VehicleDisplaySize}"
                               Aspect="Center"
                               SemanticProperties.Description="Previzualizare vehicul" />
                    </ContentView>
                </VerticalStackLayout>
            </Border>

            <!-- ===== Aplicație ===== -->
            <Label Text="Aplicație" Style="{StaticResource SectionHeaderLabel}" SemanticProperties.HeadingLevel="Level2" />

            <controls:SettingsRow Icon="🎨"
                                  Title="Temă"
                                  Subtitle="Aspectul aplicației">
                <Picker Style="{StaticResource TrailingPicker}"
                        Title="Temă"
                        ItemsSource="{Binding ThemeOptions}"
                        SelectedIndex="{Binding ThemeIndex}"
                        SemanticProperties.Description="Temă" />
            </controls:SettingsRow>

            <controls:SettingsRow Icon="🏠"
                                  Title="Ecran de pornire"
                                  Subtitle="Ce ecran se deschide la lansarea aplicației">
                <Picker Style="{StaticResource TrailingPicker}"
                        Title="Ecran de pornire"
                        ItemsSource="{Binding StartPageOptions}"
                        SelectedIndex="{Binding StartPageIndex}"
                        SemanticProperties.Description="Ecran de pornire" />
            </controls:SettingsRow>

            <!-- ===== Despre ===== -->
            <Label Text="Despre" Style="{StaticResource SectionHeaderLabel}" SemanticProperties.HeadingLevel="Level2" />

            <controls:SettingsRow Icon="✉️"
                                  Title="Trimite feedback"
                                  Subtitle="Spune-ne ce îți place sau ce putem îmbunătăți"
                                  Command="{Binding SendFeedbackCommand}"
                                  SemanticProperties.Description="Trimite feedback">
                <Label Text="›"
                       FontSize="24"
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
            </controls:SettingsRow>

            <controls:SettingsRow Icon="🧭"
                                  Title="Revezi turul de introducere"
                                  Subtitle="Arată din nou ecranele de bun venit"
                                  Command="{Binding ShowOnboardingCommand}"
                                  SemanticProperties.Description="Revezi turul de introducere">
                <Label Text="›"
                       FontSize="24"
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
            </controls:SettingsRow>

            <Label Margin="0,16,0,0"
                   HorizontalOptions="Center"
                   Style="{StaticResource SubtitleLabel}">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="Versiune: " />
                        <Span Text="{Binding AppVersion}" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
