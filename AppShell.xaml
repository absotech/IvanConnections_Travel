<Shell
    x:Class="IvanConnections_Travel.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:IvanConnections_Travel"
    xmlns:converters="clr-namespace:IvanConnections_Travel.Converters"
    xmlns:views="clr-namespace:IvanConnections_Travel.Views"
    xmlns:controls="clr-namespace:IvanConnections_Travel.Controls"
    xmlns:vm="clr-namespace:IvanConnections_Travel.ViewModels"
    FlyoutBehavior="Flyout"
    FlyoutHeaderBehavior="Fixed"
    FlyoutBackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}"
    Title="IvanConnections">

    <Shell.Resources>
        <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        
        <x:String x:Key="IconMap">&#xe55b;</x:String>
        <x:String x:Key="IconSettings">&#xe8b8;</x:String>
        <x:String x:Key="IconMedal">&#xea3f;</x:String>
        <x:String x:Key="IconSchedule">&#xe8b5;</x:String>

        <Style x:Key="StatLabel" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
    </Shell.Resources>

    <Shell.FlyoutHeader>
        <Grid x:DataType="vm:AppShellViewModel" Padding="20,40,20,24" RowSpacing="15" Margin="0,25,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <VerticalStackLayout
                Grid.Row="0"
                Spacing="16"
                IsVisible="{Binding IsLoggedIn}">

                <HorizontalStackLayout Spacing="16">
                    <Border
                        WidthRequest="60"
                        HeightRequest="60"
                        Stroke="{AppThemeBinding Light={StaticResource DividerLight}, Dark={StaticResource DividerDark}}"
                        StrokeThickness="2">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="30" />
                        </Border.StrokeShape>
                        <Image
                            Source="{Binding CurrentUser.AvatarUrl}"
                            Aspect="AspectFill"
                            WidthRequest="60"
                            HeightRequest="60"
                            SemanticProperties.Description="Avatar utilizator" />
                    </Border>

                    <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                        <Label
                            Text="{Binding CurrentUser.DisplayName}"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                        <Label
                            Text="Călător activ"
                            FontSize="12"
                            TextColor="{StaticResource Accent}"
                            FontAttributes="Italic" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>

                <FlexLayout Direction="Row" Wrap="Wrap" JustifyContent="Start">
                    <Border Style="{StaticResource ChipBorder}"
                            Margin="0,0,8,0"
                            MinimumHeightRequest="44"
                            SemanticProperties.Description="Puncte karma. Atinge pentru a vedea medaliile"
                            SemanticProperties.Hint="Deschide pagina Medalii">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenBadgesCommand}" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Label Text="⭐" FontSize="14" VerticalOptions="Center" />
                            <Label Style="{StaticResource StatLabel}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding CurrentUser.KarmaPoints}" FontAttributes="Bold"
                                              TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                        <Span Text=" karma" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </HorizontalStackLayout>
                    </Border>

                    <Border Style="{StaticResource ChipBorder}"
                            MinimumHeightRequest="44"
                            SemanticProperties.Description="Medalii câștigate. Atinge pentru a vedea medaliile"
                            SemanticProperties.Hint="Deschide pagina Medalii">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenBadgesCommand}" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Label Text="🏆" FontSize="14" VerticalOptions="Center" />
                            <Label Style="{StaticResource StatLabel}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding CurrentUser.BadgeCount}" FontAttributes="Bold"
                                              TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                        <Span Text=" medalii" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </HorizontalStackLayout>
                    </Border>
                </FlexLayout>
            </VerticalStackLayout>

            <Border
                Grid.Row="0"
                IsVisible="{Binding IsLoggedIn, Converter={StaticResource InvertedBoolConverter}}"
                Padding="16"
                StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMutedLight}, Dark={StaticResource SurfaceDark}}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="10">
                    <Label
                        Text="Salutare, Călătorule!"
                        FontAttributes="Bold"
                        FontSize="16"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                    <Label
                        Text="Autentifică-te pentru a accesa chat-ul comunității."
                        FontSize="13"
                        TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                    <Button
                        Text="Activează chatul"
                        Command="{Binding LoginCommand}"
                        Style="{StaticResource AccentButton}"
                        CornerRadius="8"
                        HeightRequest="44"
                        Margin="0,5,0,0" />
                </VerticalStackLayout>
            </Border>

            <BoxView
                Grid.Row="0"
                IsVisible="{Binding IsLoggingIn}"
                Color="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource PageBackgroundDark}}"
                Opacity="0.5"
                CornerRadius="12" />
            <ActivityIndicator
                Grid.Row="0"
                IsRunning="{Binding IsLoggingIn}"
                IsVisible="{Binding IsLoggingIn}"
                Color="{StaticResource Accent}"
                HorizontalOptions="Center"
                VerticalOptions="Center" />

            <BoxView Grid.Row="1" HeightRequest="1"
                     Color="{AppThemeBinding Light={StaticResource DividerLight}, Dark={StaticResource DividerDark}}"
                     Margin="0,10,0,0" />
        </Grid>
    </Shell.FlyoutHeader>

    <!-- Flyout menu items use the default Shell template (Android: 50dp rows, >= 44dp touch targets, selection highlight). -->

    <FlyoutItem Title="Hartă Interactivă" Route="map">
        <FlyoutItem.Icon>
            <FontImageSource FontFamily="MaterialSymbolsRounded" Glyph="{StaticResource IconMap}" Size="24"
                             Color="{StaticResource Accent}" />
        </FlyoutItem.Icon>
        <ShellContent ContentTemplate="{DataTemplate local:MainPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Medalii" Route="badges">
        <FlyoutItem.Icon>
            <FontImageSource FontFamily="MaterialSymbolsRounded" Glyph="{StaticResource IconMedal}" Size="24"
                             Color="{StaticResource Accent}" />
        </FlyoutItem.Icon>
        <ShellContent ContentTemplate="{DataTemplate views:BadgesPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Orar Metropolitan" Route="schedule">
        <FlyoutItem.Icon>
            <FontImageSource FontFamily="MaterialSymbolsRounded" Glyph="{StaticResource IconSchedule}" Size="24"
                             Color="{StaticResource Accent}" />
        </FlyoutItem.Icon>
        <ShellContent ContentTemplate="{DataTemplate views:SchedulePage}" />
    </FlyoutItem>

    <FlyoutItem Title="Setări Aplicație" Route="settings">
        <FlyoutItem.Icon>
            <FontImageSource FontFamily="MaterialSymbolsRounded" Glyph="{StaticResource IconSettings}" Size="24"
                             Color="{StaticResource Accent}" />
        </FlyoutItem.Icon>
        <ShellContent ContentTemplate="{DataTemplate views:SettingsPage}" />
    </FlyoutItem>
</Shell>
